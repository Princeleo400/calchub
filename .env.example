# Copy to .env.local for local testing, and add the same names in
# Vercel > Project > Settings > Environment Variables for the live site.
# Everything is optional: leave a value empty and that feature stays off.

# Your live domain, no trailing slash. Used for canonical links, the sitemap
# and social preview images.
NEXT_PUBLIC_SITE_URL=https://calchub.example

# Google Analytics 4 > Admin > Data streams > your web stream.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# AdSense > Account > Account information, e.g. ca-pub-1234567890123456.
NEXT_PUBLIC_ADSENSE_CLIENT=

# AdSense > Ads > By ad unit. One display unit per position, numbers only.
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_IN_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
NEXT_PUBLIC_ADSENSE_SLOT_MOBILE_BANNER=
